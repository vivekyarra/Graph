# Only synthetic/public data. Copy to .env; never commit your actual secrets.
OPENAI_API_KEY=
MAELIN_USE_LLM=auto
MAELIN_LLM_MODEL=gpt-4o-mini
# For Ollama: MAELIN_LLM_BASE_URL=http://host.docker.internal:11434/v1
MAELIN_LLM_BASE_URL=
# External FalkorDB Cloud for live deployment:
FALKOR_HOST=
FALKOR_PORT=6379
FALKOR_USERNAME=
FALKOR_PASSWORD=
FALKOR_SSL=1
MAELIN_OPERATOR_TOKEN=
