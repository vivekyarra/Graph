# Public hackathon demo: real FalkorDB+FastAPI, no non-graph engine.
# Instance-local data is ephemeral. For durable cloud persistence use Dockerfile.
FROM falkordb/falkordb-server:v4.20.4
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /app/
RUN python3 -m venv /opt/maelin-venv && /opt/maelin-venv/bin/pip install --no-cache-dir -r /app/requirements.txt
ENV PATH="/opt/maelin-venv/bin:$PATH" PYTHONUNBUFFERED=1 FALKOR_HOST=127.0.0.1 FALKOR_PORT=6379 FALKOR_SSL=0 MAELIN_AGENT_TOOLS=mcp MAELIN_ENABLE_DEMO_MUTATIONS=1 MAELIN_PUBLIC_DEMO=1
COPY maelin /app/maelin
COPY data /app/data
COPY static /app/static
COPY scripts/start-demo.sh /app/scripts/start-demo.sh
RUN chmod +x /app/scripts/start-demo.sh
EXPOSE 8000
ENTRYPOINT ["/app/scripts/start-demo.sh"]
